<Window x:Class="WorkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="250"
        Height="98"
        Background="#FF9DA1C8"
        BorderBrush="#FF0812AB"
        BorderThickness="2"
        Topmost="True"
        AllowsTransparency="True"
        Opacity="0.97" FontSize="10" WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Pixel Count Initiated..."
                       FontSize="18"
                       Margin="0 0 0 15"
                       HorizontalAlignment="Center" />

            <ProgressBar IsIndeterminate="True"
                         Height="20"
                         Width="300"
                         HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
